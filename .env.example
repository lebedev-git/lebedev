# Пароль для входа в админку (/admin). Смени на свой.
ADMIN_PASSWORD=change-me-please

# Секрет для подписи сессионных cookie. Сгенерируй длинную случайную строку.
SECRET_KEY=replace-with-a-long-random-string

# Публичный адрес сайта без слэша в конце — для превью в Telegram и sitemap.
SITE_URL=https://example.ru

# Номер счётчика Яндекс Метрики (8 цифр). Пусто — счётчик не подключается.
METRIKA_ID=
