# Портфолио a-lebedev.ru: uvicorn под systemd. Ставится в /etc/systemd/system/.
[Unit]
Description=Портфолио Андрея Лебедева (FastAPI)
After=network.target

[Service]
WorkingDirectory=/var/www/lebedev
EnvironmentFile=/var/www/lebedev/.env
ExecStart=/var/www/lebedev/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
